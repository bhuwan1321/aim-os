# AIM OS configuration. aim.py copies this to .env on first run and fills in
# random passwords. Add your own API keys (both optional: without them AIM
# falls back to the local Ollama models).

# ── API Keys (optional, free tiers) ─────────────
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── Groq Models ─────────────────────────────────
GROQ_BRAIN_MODEL=openai/gpt-oss-120b
GROQ_CODE_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Google Models ───────────────────────────────
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_THINK_MODEL=gemini-2.5-flash

# ── Local Ollama (runs in Docker, models stored in ./data/ollama) ──
OLLAMA_HOST=http://ollama:11434
OLLAMA_SCREEN_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_OFFLINE_MODEL=qwen3:4b

# ── Redis / Qdrant / Postgres ───────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
QDRANT_HOST=qdrant
QDRANT_PORT=6333
POSTGRES_DB=aimdb
POSTGRES_USER=aim
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Host bridge (runs on your computer, not in Docker) ──
AIM_BRIDGE_TOKEN=__GENERATE__
HOST_BRIDGE_URL=http://host.docker.internal:9999

# ── Voice (Baymax) ──────────────────────────────
VOICE_PERSONA=baymax
# Piper voice used as the base for the Baymax sound.
VOICE_MODEL=en_US-ryan-medium
WHISPER_MODEL=base.en

# ── AIM Settings ────────────────────────────────
AIM_ENV=production
AIM_LOG_LEVEL=INFO
AIM_SCREEN_INTERVAL=30
AIM_PROACTIVE_CONFIDENCE=0.75
AIM_MEMORY_DECAY_DAYS=30
AIM_PROJECT_NAME=AIM-OS
AIM_VERSION=0.2.0
# Where data is stored (relative to this folder)
AIM_DATA=./data
